# Copy to config/pipeline.env (ignored by git) and adjust. A variable already set in the shell
# wins over this file, so a one-off override is: VAR=value make run
# Never put real credentials in the .example file.

# Paths, relative to the repo root or absolute
DATA_LANDING=data/landing
DATALAKE_ROOT=datalake
LOG_DIR=logs
EVIDENCE_DIR=evidence/entrega-2

# Runtime. Spark 4.2 runs on JDK 17, 21 or 25; the evidence was produced on 21.
PIPELINE_JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
FILES_PER_PARTITION=1

# Streaming: available_now drains Landing and stops (runs and demo);
# processing_time keeps the query running with STREAM_PROCESSING_TIME as trigger.
STREAM_TRIGGER=available_now
STREAM_PROCESSING_TIME=1 minute
STREAM_MAX_FILES_PER_TRIGGER=10
STREAM_WATERMARK=1 hour

# Serving: cassandra (local Docker, infra/docker-compose.yml), astra, or none
SERVING_TARGET=cassandra
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=cloud_analytics
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# AstraDB, only with SERVING_TARGET=astra. Keep the bundle outside the repo.
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_TOKEN=

# Anomalies (D12)
ANOMALY_THRESHOLD=3.5
ANOMALY_WINDOW_DAYS=28
ANOMALY_MIN_HISTORY=14

# Salt for hashing users.email in Silver; the pipeline stops without it. make setup generates one.
PII_HASH_SALT=
